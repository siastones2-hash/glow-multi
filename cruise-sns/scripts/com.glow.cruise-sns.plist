<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.glow.cruise-sns</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/apple/glow-multi/cruise-sns/scripts/scheduler.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PLAYWRIGHT_BROWSERS_PATH</key>
    <string>/Users/apple/Library/Caches/ms-playwright</string>
  </dict>
  <key>StartInterval</key>
  <integer>600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/apple/glow-multi/cruise-sns/data/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/apple/glow-multi/cruise-sns/data/launchd.err.log</string>
  <key>WorkingDirectory</key>
  <string>/Users/apple/glow-multi/cruise-sns</string>
</dict>
</plist>
